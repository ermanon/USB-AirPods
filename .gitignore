# this will handle to macos hidden folders
# ignore all starts with .* except .git and so on
.*
!.git*
!.editorconfig
!.vscode/launch.json
!.vscode/settings.json

# build folder
/build*
# Local diagnostics and generated artifacts
*.log
*.zip
__pycache__/
*.pyc

# Windows companion generated outputs
/windows-tray/dist/
/windows-tray/test-output/

