# Apply the bundled TinyUSB 0.18 workaround to a build-local source copy.
# Never modify the user's shared Pico SDK.
if(PICO_PLATFORM STREQUAL "rp2350-arm-s" AND TARGET tinyusb_device_base)
    set(usb_port_dir "${PICO_TINYUSB_PATH}/src/portable/raspberrypi/rp2040")
    set(usb_port_source "${usb_port_dir}/rp2040_usb.c")
    file(READ "${usb_port_source}" usb_port_content)
    set(usb_panic "panic(\"ep %02X was already available\", ep->ep_addr);")
    string(FIND "${usb_port_content}" "${usb_panic}" usb_panic_pos)
    if(NOT usb_panic_pos EQUAL -1)
        string(REPLACE "${usb_panic}" "/* USBPods RP2350 workaround: AVAIL is cleared below. */"
            usb_port_content "${usb_port_content}")
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/tinyusb-patched")
        set(usb_patched_source "${CMAKE_BINARY_DIR}/tinyusb-patched/rp2040_usb.c")
        file(WRITE "${usb_patched_source}" "${usb_port_content}")
        get_target_property(usb_device_sources tinyusb_device_base INTERFACE_SOURCES)
        list(FIND usb_device_sources "${usb_port_source}" usb_source_index)
        if(usb_source_index EQUAL -1)
            message(FATAL_ERROR "TinyUSB source layout changed; cannot apply RP2350 workaround")
        endif()
        list(REMOVE_AT usb_device_sources ${usb_source_index})
        list(APPEND usb_device_sources "${usb_patched_source}")
        set_property(TARGET tinyusb_device_base PROPERTY INTERFACE_SOURCES "${usb_device_sources}")
        target_include_directories(tinyusb_device_base INTERFACE "${usb_port_dir}")
        message(STATUS "USBPods: applied TinyUSB RP2350 workaround to build-local source")
    endif()
endif()
